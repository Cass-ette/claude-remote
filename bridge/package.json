{
  "name": "@claude-remote/bridge",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/claude/lease-watcher.mjs dist/src/claude/lease-watcher.mjs && mkdir -p dist/permission-adapter && cp src/permission-adapter/main.mjs dist/permission-adapter/main.mjs",
    "start": "node dist/src/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.3.0",
    "canonicalize": "^2.0.0",
    "fastify": "^5.0.0",
    "@fastify/websocket": "^11.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jose": "^5.9.0",
    "pino": "^9.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
