{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-remote/probes/gate-result.schema.json",
  "title": "GateResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "status", "startedAt", "finishedAt", "checks", "evidence"],
  "properties": {
    "name": {
      "type": "string",
      "enum": ["claude", "transcript", "cloudflare"]
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "not_run"]
    },
    "startedAt": { "type": "string" },
    "finishedAt": { "type": "string" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed"],
        "properties": {
          "name": { "type": "string" },
          "passed": { "type": "boolean" },
          "details": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    }
  }
}
