<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only loopback cleartext allowance: the debug default bridge host is
  the emulator's host-loopback alias (http://10.0.2.2:43111) and the E2E
  instrumented suite drives an embedded fake bridge on 127.0.0.1 — both plain
  HTTP. Release keeps the platform default (no cleartext): production bridges
  are reached over https via the user-entered host.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
