{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-remote.dev/contracts/v1/response.schema.json",
  "title": "Protocol v1 response",
  "description": "Response returned by the bridge for a command, either command.status or command.error.",
  "type": "object",
  "required": ["protocolVersion", "requestId", "responseType"],
  "properties": {
    "protocolVersion": { "const": "claude-remote.v1" },
    "requestId": { "type": "string", "format": "uuid" },
    "responseType": { "enum": ["command.status", "command.error"] },
    "commandStatus": {
      "enum": [
        "accepted",
        "dispatching",
        "dispatched",
        "indeterminate",
        "interrupted",
        "completed",
        "failed"
      ]
    },
    "result": true,
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "responseType": { "const": "command.status" } } },
      "then": {
        "properties": {
          "commandStatus": { "$ref": "#/properties/commandStatus" }
        },
        "required": ["commandStatus"]
      }
    },
    {
      "if": { "properties": { "responseType": { "const": "command.error" } } },
      "then": {
        "properties": { "error": { "$ref": "#/properties/error" } },
        "required": ["error"]
      }
    }
  ]
}
